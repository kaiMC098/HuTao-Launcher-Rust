<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hutao_left_hero_col"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        app:layout_constraintBottom_toTopOf="@id/hutao_rust_status_bar"
        app:layout_constraintEnd_toStartOf="@id/hutao_right_scroll"
        app:layout_constraintHorizontal_weight="1.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/hutao_hero_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:contentDescription="@string/app_short_name"
            android:scaleType="centerCrop"
            android:src="@drawable/hutao_hero_card_art"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/hutao_renderer_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="@drawable/hutao_status_chip_bg"
            android:fontFamily="@font/noto_sans_bold"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_2sdp"
            android:text="Renderer: GL4ES"
            android:textColor="@color/hutao_amber_gold"
            android:textSize="@dimen/_7ssp"
            app:layout_constraintStart_toStartOf="@id/hutao_hero_image"
            app:layout_constraintTop_toTopOf="@id/hutao_hero_image" />

        <TextView
            android:id="@+id/hutao_jre_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:background="@drawable/hutao_status_chip_bg"
            android:fontFamily="@font/noto_sans_bold"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_2sdp"
            android:text="JRE: 4/4"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_7ssp"
            app:layout_constraintEnd_toEndOf="@id/hutao_hero_image"
            app:layout_constraintTop_toTopOf="@id/hutao_hero_image" />

        <TextView
            android:id="@+id/hutao_welcome_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_26sdp"
            android:fontFamily="@font/noto_sans_bold"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:text="Welcome back, Traveler!"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintBottom_toBottomOf="@id/hutao_hero_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="@dimen/_165sdp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:minHeight="@dimen/_40sdp"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:text="CHƠI (PLAY)"
            android:textAllCaps="false"
            android:textColor="@color/primary_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/hutao_right_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        app:layout_constraintBottom_toTopOf="@id/hutao_rust_status_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/hutao_left_hero_col"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/hutao_panel_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_6sdp">

                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawableEnd="@drawable/spinner_arrow"
                    app:drawableEndPadding="@dimen/_1sdp"
                    app:drawableEndSize="@dimen/_10sdp"
                    app:drawableStartIntegerScaling="true"
                    app:drawableStartSize="@dimen/_22sdp" />

                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/global_edit"
                    android:src="@drawable/ic_edit_profile"
                    android:tint="@color/hutao_amber_gold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/java_settings_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_marginEnd="@dimen/_3sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_grid_card_bg"
                    android:drawableStart="@drawable/ic_hutao_java_gear"
                    android:drawablePadding="@dimen/_6sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="JAVA"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_9ssp" />

                <Button
                    android:id="@+id/install_jar_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_grid_card_bg"
                    android:drawableStart="@drawable/ic_hutao_mods_palette"
                    android:drawablePadding="@dimen/_6sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="MODS &amp; JAR"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/account_menu_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_marginEnd="@dimen/_3sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_grid_card_bg"
                    android:drawableStart="@drawable/ic_hutao_account_person"
                    android:drawablePadding="@dimen/_6sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="TÀI KHOẢN"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_9ssp" />

                <Button
                    android:id="@+id/open_files_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_grid_card_bg"
                    android:drawableStart="@drawable/ic_hutao_library_grid"
                    android:drawablePadding="@dimen/_6sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="THƯ VIỆN"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/custom_control_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_panel_card_bg"
                    android:text="Phím ảo"
                    android:textAllCaps="false"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_8ssp" />

                <Button
                    android:id="@+id/video_settings_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_panel_card_bg"
                    android:text="Đồ họa"
                    android:textAllCaps="false"
                    android:textColor="@color/hutao_amber_gold"
                    android:textSize="@dimen/_8ssp" />

                <Button
                    android:id="@+id/share_logs_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_panel_card_bg"
                    android:text="Log"
                    android:textAllCaps="false"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_8ssp" />

                <Button
                    android:id="@+id/discord_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_panel_card_bg"
                    android:text="Discord"
                    android:textAllCaps="false"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_8ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/hutao_panel_card_bg"
                android:orientation="vertical"
                android:padding="@dimen/_7sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hutao_memory_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/noto_sans_bold"
                        android:text="Memory: -- / -- GB"
                        android:textColor="@color/primary_text"
                        android:textSize="@dimen/_9ssp" />

                    <Button
                        android:id="@+id/hutao_clean_cache_button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_20sdp"
                        android:background="@drawable/hutao_select_button_bg"
                        android:fontFamily="@font/noto_sans_bold"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="@dimen/_6sdp"
                        android:paddingVertical="0dp"
                        android:text="Dọn Cache"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_text"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/hutao_memory_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:max="100"
                    android:progress="55"
                    android:progressDrawable="@drawable/hutao_memory_progress" />

                <TextView
                    android:id="@+id/hutao_soc_info_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="SoC Optimizer: Ready"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_7ssp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/hutao_rust_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:background="@drawable/hutao_panel_card_bg"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_4sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/hutao_rust_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="[Rust] Loaded jniLibs successfully. Host: Android_aarch64"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_8ssp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
