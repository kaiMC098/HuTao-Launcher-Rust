<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorPrimary">@color/hutao_crimson_primary</item>
        <item name="colorPrimaryDark">@color/background_status_bar</item>
        <item name="colorAccent">@color/hutao_amber_gold</item>
        <item name="android:windowBackground">@color/background_app</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_bottom_bar</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="preferenceTheme">@style/HuTaoPreferenceTheme</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="HuTaoPreferenceTheme" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceStyle">@style/HuTaoPreferenceItem</item>
        <item name="preferenceCategoryStyle">@style/HuTaoPreferenceCategory</item>
        <item name="switchPreferenceStyle">@style/HuTaoSwitchPreference</item>
        <item name="switchPreferenceCompatStyle">@style/HuTaoSwitchPreferenceCompat</item>
        <item name="dialogPreferenceStyle">@style/HuTaoDialogPreference</item>
        <item name="editTextPreferenceStyle">@style/HuTaoEditTextPreference</item>
    </style>

    <style name="HuTaoPreferenceItem" parent="@style/Preference.Material">
        <item name="android:layout">@layout/pref_hutao_item</item>
    </style>

    <style name="HuTaoPreferenceCategory" parent="@style/Preference.Category.Material">
        <item name="android:layout">@layout/pref_hutao_category</item>
    </style>

    <style name="HuTaoSwitchPreference" parent="@style/Preference.SwitchPreference.Material">
        <item name="android:layout">@layout/pref_hutao_item</item>
    </style>

    <style name="HuTaoSwitchPreferenceCompat" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/pref_hutao_item</item>
    </style>

    <style name="HuTaoDialogPreference" parent="@style/Preference.DialogPreference.Material">
        <item name="android:layout">@layout/pref_hutao_item</item>
    </style>

    <style name="HuTaoEditTextPreference" parent="@style/Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/pref_hutao_item</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/hutao_menu_item_bg</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_60sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
