        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_10sdp" />
            <solid android:color="#5E161B" />
            <stroke android:width="1dp" android:color="#FF6B5A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_10sdp" />
            <solid android:color="#361014" />
            <stroke android:width="1dp" android:color="#A83232" />
        </shape>
    </item>
</selector>
