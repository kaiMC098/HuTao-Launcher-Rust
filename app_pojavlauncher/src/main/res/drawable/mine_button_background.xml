<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_10sdp" />
            <gradient
                android:angle="0"
                android:startColor="#FF5A36"
                android:endColor="#B82525" />
            <stroke
                android:width="1.5dp"
                android:color="#FFD166" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_10sdp" />
            <solid android:color="#3D1D22" />
            <stroke
                android:width="1dp"
                android:color="#6E262E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_10sdp" />
            <gradient
                android:angle="0"
                android:startColor="#E63B2E"
                android:centerColor="#C92A2A"
                android:endColor="#8F1922" />
            <stroke
                android:width="1.5dp"
                android:color="@color/hutao_amber_gold" />
        </shape>
    </item>
</selector>
