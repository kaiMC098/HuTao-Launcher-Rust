<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_12sdp" />
            <solid android:color="#4E181D" />
            <stroke android:width="1dp" android:color="#E84C24" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_12sdp" />
            <gradient
                android:angle="270"
                android:startColor="#341013"
                android:endColor="#250A0C" />
            <stroke android:width="1dp" android:color="#612327" />
        </shape>
    </item>
</selector>
