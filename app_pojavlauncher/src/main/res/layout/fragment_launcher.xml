<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintBottom_toTopOf="@id/hutao_rust_status_bar"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Art Card (Hu Tao + Boo Tao in Minecraft) + overlapping CHƠI (PLAY) button -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/hutao_hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_185sdp"
                    android:contentDescription="@string/app_short_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/hutao_hero_card_art"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/hutao_welcome_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_26sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:text="Welcome back, Traveler!"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_15ssp"
                    app:layout_constraintBottom_toBottomOf="@id/hutao_hero_image"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/play_button"
                    android:layout_width="@dimen/_190sdp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-20dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:minHeight="@dimen/_48sdp"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:text="CHƠI (PLAY)"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/hutao_hero_image" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Compact Profile / Version Selector Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/hutao_panel_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_6sdp">

                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawableEnd="@drawable/spinner_arrow"
                    app:drawableEndPadding="@dimen/_1sdp"
                    app:drawableEndSize="@dimen/_10sdp"
                    app:drawableStartIntegerScaling="true"
                    app:drawableStartSize="@dimen/_24sdp" />

                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/global_edit"
                    android:src="@drawable/ic_edit_profile"
                    android:tint="@color/hutao_amber_gold" />
            </LinearLayout>

            <!-- 4-Row Feature Menu Card (exact match to 25598.png) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/hutao_panel_card_bg"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_4sdp">

                <Button
                    android:id="@+id/java_settings_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_hutao_java_gear"
                    android:drawablePadding="@dimen/_10sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:text="CÀI ĐẶT JAVA"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_11ssp" />

                <Button
                    android:id="@+id/install_jar_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_hutao_mods_palette"
                    android:drawablePadding="@dimen/_10sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:text="MODS &amp; SHADERS"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_11ssp" />

                <Button
                    android:id="@+id/account_menu_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_hutao_account_person"
                    android:drawablePadding="@dimen/_10sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:text="TÀI KHOẢN"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_11ssp" />

                <Button
                    android:id="@+id/open_files_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_hutao_library_grid"
                    android:drawablePadding="@dimen/_10sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:text="THƯ VIỆN"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_11ssp" />
            </LinearLayout>

            <!-- Compact Utility Strip (Controls, Share Logs, Wiki, Discord) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/custom_control_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_panel_card_bg"
                    android:text="Phím ảo"
                    android:textAllCaps="false"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_9ssp" />

                <Button
                    android:id="@+id/share_logs_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_panel_card_bg"
                    android:text="Log"
                    android:textAllCaps="false"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_9ssp" />

                <Button
                    android:id="@+id/news_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_panel_card_bg"
                    android:text="Wiki"
                    android:textAllCaps="false"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_9ssp" />

                <Button
                    android:id="@+id/discord_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/hutao_panel_card_bg"
                    android:text="Discord"
                    android:textAllCaps="false"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <!-- Live Memory Usage Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/hutao_panel_card_bg"
                android:orientation="vertical"
                android:padding="@dimen/_10sdp">

                <TextView
                    android:id="@+id/hutao_memory_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="Memory: 4.5 GB / 8.0 GB"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_10ssp" />

                <ProgressBar
                    android:id="@+id/hutao_memory_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_6sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:max="100"
                    android:progress="56"
                    android:progressDrawable="@drawable/hutao_memory_progress" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Rust Native Engine Status Bar -->
    <LinearLayout
        android:id="@+id/hutao_rust_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@drawable/hutao_panel_card_bg"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/hutao_rust_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="[Rust] Loaded jniLibs successfully. Host: Android_aarch64"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_8ssp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
